{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VADOS",
  "version": "0.3.0",
  "identifier": "com.vadim.vados",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VAD/OS",
        "width": 1060,
        "height": 620,
        "minWidth": 690,
        "minHeight": 560,
        "backgroundColor": "#0a0a0c",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
